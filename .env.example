# Copy to .env and fill in the values supplied by your mentor.

APP_HOST=
APP_PORT=
CORS_ORIGINS=*
DATA_DIR=./backend/data
TOOL_GATEWAY_KEY=

# ---- OCR ----
OCR_API_URL=
OCR_ENDPOINT_PATH=/ocr
OCR_API_KEY=
OCR_AUTH_MODE=bearer
OCR_AUTH_HEADER_NAME=x-api-key
OCR_FILE_FIELD_NAME=file
OCR_TIMEOUT_SECONDS=60

# ---- Local LLM ----
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=
LOCAL_LLM_TIMEOUT_SECONDS=120

# ---- Frontier Gemini ----
FRONTIER_PROVIDER=gemini
FRONTIER_API_KEY=
FRONTIER_MODEL=
FRONTIER_ENABLE_WEB_SEARCH=true
FRONTIER_TIMEOUT_SECONDS=120

# ---- MCP gateway ----
MCP_CLIENT_MODE=inprocess
MCP_CLIENT_BASE_URL=http://localhost:8000

# ---- Sandbox ----
SANDBOX_PYTHON=
SANDBOX_TIMEOUT_SECONDS=45

# ---- Trusted Dd / certificate verification ----
CERTIFICATE_TRUSTED_REGISTRY_REQUIRED=true
